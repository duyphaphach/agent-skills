# MCP server transport and HTTP binding.
MCP_TRANSPORT=stdin
HOST=127.0.0.1
PORT=8220
ALLOWED_HOSTS=127.0.0.1,localhost

# Shared Dify API connection and auth settings.
DIFY_BASE_URL=https://qaland.ekotek.cloud/v1
DIFY_API_KEY=
DIFY_KNOWLEDGE_API_KEY=
DIFY_WORKFLOW_API_KEY=
DIFY_TIMEOUT_MS=120000
DIFY_CACHE_TTL_MS=30000

# Log level: debug, info, warn, error
QALAND_MCP_LOG_LEVEL=info

# QA knowledge retrieval datasets and default queries.
QALAND_QA_PROJECT_KNOWLEDGE_DATASET_ID=
QALAND_QA_TEST_CASE_EXAMPLE_DATASET_ID=
QALAND_QA_MESSAGE_RETRIEVAL_QUERY=Message
QALAND_QA_SMS_RETRIEVAL_QUERY=SMS
QALAND_QA_EMAIL_RETRIEVAL_QUERY=Email
QALAND_QA_TEST_CASE_EXAMPLE_RETRIEVAL_QUERY=Example Test Cases
