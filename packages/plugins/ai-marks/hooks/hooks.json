{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/fix-file.py\"",
            "timeout": 5,
            "statusMessage": "ai-marks: fixing AI-trace characters..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/lint-reply.py\"",
            "timeout": 5,
            "statusMessage": "ai-marks: checking reply..."
          }
        ]
      }
    ]
  }
}
