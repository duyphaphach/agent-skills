# Stem caches - derived from the wordlists, regenerated on first use.
*.cache
.cache/
.stems-cache/

# Python bytecode and tool caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and OS noise (also covered by the repo-root ignore; kept here so
# this folder is portable if the plugin is published as a standalone repo).
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Raw upstream source data. Pulled, not part of the final plugin distribution.
# Regenerate wordlists/ngsl-nawl-combined.txt with raw/regenerate.sh.
raw/

# Local-only development artifacts
*.local
*.bak
*.orig
*.tmp
